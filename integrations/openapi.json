{
  "openapi": "3.1.0",
  "info": {
    "title": "Echo Context API",
    "version": "1.0.0",
    "description": "Read and update the signed-in user's portable AI context. Context is encrypted and access-controlled by Echo."
  },
  "servers": [
    { "url": "https://echo-api-zivt.onrender.com", "description": "Echo production API" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/context": {
      "get": {
        "operationId": "getEchoContext",
        "summary": "Load the user's Echo context",
        "description": "Use this when background about the user's preferences, projects, or previous decisions would improve the answer.",
        "responses": {
          "200": {
            "description": "The user's saved context",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "context": { "type": ["object", "null"], "additionalProperties": true },
                    "cid": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Missing or invalid Echo credentials" }
        }
      },
      "post": {
        "operationId": "saveEchoContext",
        "summary": "Save the user's Echo context",
        "description": "Call only when the user explicitly asks to remember or update information.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["context"],
                "properties": {
                  "context": { "type": "object", "additionalProperties": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Context saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cid": { "type": "string" },
                    "hash": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Missing or invalid Echo credentials" }
        }
      }
    },
    "/v1/access": {
      "get": {
        "operationId": "listEchoAccess",
        "summary": "List applications approved to use Echo context",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current application permissions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "app": { "type": "string" },
                          "active": { "type": "boolean" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Echo account API token"
      }
    }
  }
}
